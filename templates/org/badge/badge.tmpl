{{if .LinkURL}}<a class="org-badge" href="{{.LinkURL}}" target="_blank" rel="noopener noreferrer nofollow" aria-label="{{.HoverText}}"><img width="48" height="48" src="{{.IconURL}}" alt="{{.Name}}" loading="lazy"><span class="org-badge-tip" role="tooltip"><strong>{{.Name}}</strong>{{if .Description}}<span>{{.Description}}</span>{{end}}</span></a>{{else}}<span class="org-badge" tabindex="0" aria-label="{{.HoverText}}"><img width="48" height="48" src="{{.IconURL}}" alt="{{.Name}}" loading="lazy"><span class="org-badge-tip" role="tooltip"><strong>{{.Name}}</strong>{{if .Description}}<span>{{.Description}}</span>{{end}}</span></span>{{end}}
