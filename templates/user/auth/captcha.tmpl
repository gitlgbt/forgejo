{{if .EnableCaptcha}}
	<div class="required field {{if .Err_Captcha}}error{{end}}">
		<label for="captcha">
			{{ctx.Locale.Tr "captcha"}}:
			<span id="captcha-aid">{{ctx.Locale.Tr "cregister.captcha"}}</span>
		</label>
		<div class="inline field tw-text-center" aria-hidden="true">
			<input type="hidden" name="img-captcha-id" value="{{.Captcha}}">
			<img alt="" style="transform: scaleX(-1);background-color: white" onclick="this.src=`{{AppSubUrl}}/captcha/{{.Captcha}}.png?reload=${Date.now()}`" class="captcha-img" src="{{AppSubUrl}}/captcha/{{.Captcha}}.png">
		</div>
		<!-- references help text banner at the top of the page -->
		<input id="captcha" name="img-captcha-response" autocomplete="off" aria-labelledby="captcha-intro captcha-aid codeberg-service captcha-morehelp" required>
	</div>
{{end}}
